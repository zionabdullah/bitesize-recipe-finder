# BiteSize Environment Variables Configuration
PORT=3000

# Spoonacular API Key (Get a free key from https://spoonacular.com/food-api)
# If left empty, the server automatically uses rich mock fallback data!
SPOONACULAR_API_KEY=

# Google Gemini API Key for AI Fridge Vision scanning (Optional)
# If left empty, the vision endpoint uses intelligent mock vision fallback!
GEMINI_API_KEY=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
